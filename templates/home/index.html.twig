{% extends 'base.html.twig' %}

{% block title %}La Casa Gaudencia{% endblock %}

{% block body %}
<style>
    body {
        margin: 0;
        font-family: 'Lato', sans-serif;
        background-color: #fcfbf7;
    }

    /* Navbar */
    .navbar {
        position: fixed;
        top: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #fcfbf7; /* cream base */
        padding: 15px 50px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        z-index: 1000;
        overflow: hidden;
    }

   
    .navbar::before {
        content: "";
        position: absolute;
        inset: 0;
        background: url('{{ asset("pictures/background.png") }}') repeat;
        background-size: 100px; /* smaller pattern = more repeats */
        opacity: 0.25; /* only pattern fades, not text/logo */
        z-index: 0;
    }

    /* Ensure content stays above the overlay */
    .navbar .logo,
    .navbar ul {
        position: relative;
        z-index: 1;
    }

    .navbar .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        font-weight: bold;
        color: #c24a16;
    }
    .navbar .logo img {
        height: 50px;
        width: auto;
    }
    .navbar ul {
        list-style: none;
        display: flex;
        gap: 25px;
        margin: 0;
        padding: 0;
    }
    .navbar ul li a {
        text-decoration: none;
        color: #000;
        font-weight: 500;
        transition: color 0.3s;
    }
    .navbar ul li a:hover {
        color: #c24a16;
    }

    /* Hero Section */
    .hero {
        height: 100vh;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.4)), 
            url('{{ asset("pictures/ground.jpeg") }}') center/cover no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: #fff;
        padding: 0 20px;
    }
    .hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: 48px;
        margin-bottom: 20px;
    }
    .hero .btn {
        margin-top: 20px;
        background: #c24a16;
        color: #fff;
        padding: 12px 25px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 18px;
        transition: background 0.3s;
    }
    .hero .btn:hover {
        background: #a93e10;
    }

    /* Why Choose Us */
    .features {
        display: flex;
        justify-content: center;
        gap: 40px;
        padding: 80px 20px;
        text-align: center;
        flex-wrap: wrap;
    }
    .features div {
        max-width: 250px;
    }
    .features h3 {
        font-family: 'Playfair Display', serif;
        margin-bottom: 10px;
    }

    /* Experience Categories */
    .experiences {
        padding: 80px 20px;
        background: #fff;
        text-align: center;
    }
    .experience-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }
    .card {
        position: relative;
        height: 250px;
        border-radius: 12px;
        overflow: hidden;
        color: #fff;
        text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: transform 0.3s;
    }
    .card:hover {
        transform: translateY(-5px);
    }
    .card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.35); /* overlay to make text readable */
    }
    .card h4, .card p, .card a {
        position: relative;
        z-index: 1;
    }
    .card a {
        color: #fff;
        font-weight: bold;
        text-decoration: underline;
    }

    /* Category Backgrounds */
    .relaxation {
        background: url('{{ asset("pictures/relaxation.jpeg") }}') center/cover no-repeat;
    }
    .adventure {
        background: url('{{ asset("pictures/adventure.jpg") }}') center/cover no-repeat;
    }
    .culture {
        background: url('{{ asset("pictures/culture.webp") }}') center/cover no-repeat;
    }
    .luxury {
        background: url('{{ asset("pictures/luxury.webp") }}') center/cover no-repeat;
    }

    /* Call to Action */
    .cta {
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.5)), 
            url('{{ asset("pictures/ground.jpeg") }}') center/cover no-repeat;
        padding: 100px 20px;
        text-align: center;
        color: #fff;
    }
    .cta h2 {
        font-size: 36px;
        margin-bottom: 20px;
    }
    .cta a {
        background: #c24a16;
        padding: 15px 30px;
        color: #fff;
        border-radius: 8px;
        text-decoration: none;
        font-size: 18px;
        transition: background 0.3s;
    }
    .cta a:hover {
        background: #a93e10;
    }

    /* Footer */
    footer {
        background: #c24a16;
        color: #fff;
        padding: 40px 20px;
        text-align: center;
    }
    footer p {
        margin: 5px 0;
    }
</style>

<!-- Navbar -->
<header class="navbar">
    <div class="logo">
        <img src="{{ asset('pictures/WEB.png') }}" alt="Logo">
        La Casa Gaudencia
    </div>
    <ul>
        <li><a href="#Home">Home</a></li>
        <li><a href="#Experiences">Experiences</a></li>
        <li><a href="#Book">Book Now</a></li>
        <li><a href="#About">About</a></li>
        <li><a href="#Contact">Contact</a></li>

    </ul>
</header>

<!-- Hero Section -->
<section class="hero">
    <h1>“A House of Joy, Warmth, and Memories”</h1>
    <a href="#experiences" class="btn">Start Your Experience</a>
</section>

<!-- Why Choose Us -->
<section class="features">
    <div>
        <h3>🛏️ Cozy Boutique Stay</h3>
        <p>Feel at home with comfort and elegance.</p>
    </div>
    <div>
        <h3>🌏 Tailored Travel Packages</h3>
        <p>Designed to match your dream journey.</p>
    </div>
    <div>
        <h3>❤️ Unforgettable Memories</h3>
        <p>Create lasting experiences with us.</p>
    </div>
</section>

<!-- Experience Categories -->
<section class="experiences" id="experiences">
    <h2>Choose Your Experience</h2>
    <div class="experience-cards">
        <div class="card relaxation">
            <h4>🌿 Relaxation</h4>
            <p>Peaceful retreats designed for you.</p>
            <a href="#book">Book Now</a>
        </div>
        <div class="card adventure">
            <h4>🏞️ Adventure</h4>
            <p>Exciting activities for thrill-seekers.</p>
            <a href="#book">Book Now</a>
        </div>
        <div class="card culture">
            <h4>🎭 Culture</h4>
            <p>Discover local traditions and heritage.</p>
            <a href="#book">Book Now</a>
        </div>
        <div class="card luxury">
            <h4>🍷 Luxury</h4>
            <p>Indulge in world-class amenities.</p>
            <a href="#book">Book Now</a>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta" id="book">
    <h2>Your journey begins here</h2>
    <a href="/book">Book Your Stay</a>
</section>

<!-- Footer -->
<footer id="contact">
    <p>📍 Dumaguete City, Philippines</p>
    <p>📧 lacasagaudencia@gmail.com | 📞 +63 912 578 6789</p>
    <p>Follow us: Facebook | Instagram</p>
    <p>© 2025 La Casa Gaudencia</p>
</footer>

{% endblock %}
