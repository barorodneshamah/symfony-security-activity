{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<style>
    body {
        font-family: "Segoe UI", Arial, sans-serif;
        color: #333;
        margin: 0;
        padding: 0;
        transition: background 0.5s ease;
    }

    /* Admin background (Orange theme) */
    body.admin-bg {
        background: linear-gradient(135deg, #ff9966, #ff5e00);
    }

    /* User background (Blue theme) */
    body.user-bg {
        background: linear-gradient(135deg, #74ABE2, #5563DE);
    }

    .dashboard-container {
        max-width: 500px;
        margin: 100px auto;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        padding: 40px;
        text-align: center;
        animation: fadeIn 0.6s ease;
    }

    h1 {
        margin-bottom: 15px;
        font-weight: bold;
    }

    .admin-title {
        color: #d35400; /* Dark orange for title */
    }

    .user-title {
        color: #0d6efd;
    }

    p {
        font-size: 16px;
        line-height: 1.5;
    }

    .admin-msg {
        background: #ffe5cc;
        color: #7a2e00;
        border: 1px solid #ffc299;
        padding: 10px;
        border-radius: 8px;
        margin-top: 20px;
    }

    .user-msg {
        background: #cff4fc;
        color: #055160;
        border: 1px solid #b6effb;
        padding: 10px;
        border-radius: 8px;
        margin-top: 20px;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

{% if app.user %}
    {% if is_granted('ROLE_ADMIN') %}
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                document.body.classList.add('admin-bg');
            });
        </script>
        <div class="dashboard-container">
            <h1 class="admin-title">Admin Dashboard</h1>
            <p>Welcome, <strong>{{ app.user.userIdentifier }}</strong>!</p>
            <div class="admin-msg">
                You are logged in as <strong>Admin</strong>. You have full access.
            </div>
        </div>

    {% elseif is_granted('ROLE_USER') %}
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                document.body.classList.add('user-bg');
            });
        </script>
        <div class="dashboard-container">
            <h1 class="user-title">User Dashboard</h1>
            <p>Welcome, <strong>{{ app.user.userIdentifier }}</strong>!</p>
            <div class="user-msg">
                You are logged in as <strong>Regular User</strong>. Limited access granted.
            </div>
        </div>
    {% endif %}
{% endif %}
{% endblock %}
